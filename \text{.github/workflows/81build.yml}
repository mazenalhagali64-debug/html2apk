name: Build APK from Zip

on:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Unzip project archive
        run: |
          unzip studio-pro-v3.zip -d project_folder

      - name: Set up JDK 17
        uses: actions/setup-java@v3
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Build APK
        run: |
          cd project_folder
          # سيقوم هذا الجزء بالبناء إذا كان مشروعك يحتوي على ملفاتgradle
          if [ -f "gradlew" ]; then
            chmod +x gradlew
            ./gradlew assembleDebug
          else
            echo "No gradlew found in the zip root, checking files..."
            ls -la
          fi
